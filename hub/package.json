{
  "name": "gc-tally",
  "version": "0.6.1",
  "private": true,
  "main": "tray-main.js",
  "dependencies": {
    "atem-connection": "^3.0.0-nightly-latest-20211125-222857-2b30eea.0",
    "escape-string-regexp": "^4.0.0",
    "express": "^4.17.2",
    "forever-monitor": "^3.0.3",
    "http-proxy-middleware": "^1.3.1",
    "midi": "^1.0.4",
    "nodemcu-tool": "github:wifi-tally/NodeMCU-Tool",
    "obs-websocket-js": "^4.0.3",
    "socket.io": "^2.4.1",
    "socket.io-client": "^2.4.0",
    "tmp-promise": "^3.0.3",
    "xml2js": "^0.4.23",
    "yargs": "^15.4.1"
  },
  "scripts": {
    "start:frontend": "vite --host 0.0.0.0",
    "start:backend": "ts-node --project tsconfig.server.json src/server.ts --env=development",
    "build:frontend": "node scripts/write-build-info.js && vite build",
    "build:backend": "tsc --project tsconfig.server.json",
    "build:windows": "npm run build:frontend && npm run build:backend && node scripts/package-windows.js",
    "build:tray": "npm run build:windows && electron-builder --win portable",
    "test": "jest --config jest.standalone.cjs",
    "test:ci": "jest --config jest.standalone.cjs --watch=false --runInBand",
    "cypress:open": "cypress open",
    "cypress:backend": "ts-node --project tsconfig.server.json src/server.ts --env=development --with-test",
    "lint": "eslint .",
    "preview:frontend": "vite preview",
    "test:frontend:smoke": "node scripts/check-vite-output.cjs && node scripts/check-vite-preview.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.60",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "@types/express": "^4.17.13",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^16.14.21",
    "@types/react-dom": "^16.9.14",
    "@types/react-router": "^5.1.17",
    "@types/react-router-dom": "^5.3.2",
    "@types/socket.io": "^2.1.13",
    "@types/socket.io-client": "^1.4.36",
    "@types/tmp": "^0.2.3",
    "@yao-pkg/pkg": "6.23.0",
    "babel-jest": "30.5.2",
    "cross-env": "^7.0.3",
    "cypress": "^6.9.1",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "eslint": "10.13.0",
    "eslint-plugin-cypress": "7.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-extended": "^0.11.5",
    "lato-font": "^3.0.0",
    "nosleep.js": "^0.12.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-full-screen": "1.1.1",
    "react-router-dom": "^5.3.0",
    "ts-node": "^9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "web-vitals": "^0.2.4"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm"
  ],
  "build": {
    "extends": null,
    "appId": "pl.greencrew.gctally",
    "productName": "GC Tally",
    "npmRebuild": false,
    "files": [
      "tray-main.js"
    ],
    "extraResources": [
      {
        "from": "dist/gc-tally.exe",
        "to": "gc-tally.exe"
      },
      {
        "from": "dist/frontend",
        "to": "frontend"
      },
      {
        "from": "../art/GreenCrew_Tally_logo.svg",
        "to": "GreenCrew_Tally_logo.svg"
      },
      {
        "from": "tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "dist/esp8266",
        "to": "esp8266"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pkg": {
    "assets": [
      "node_modules/@serialport/bindings/build/Release/*.node",
      "node_modules/@serialport/bindings/prebuilds/**/*.node",
      "node_modules/midi/build/Release/*.node"
    ]
  }
}

{
  "name": "gc-tally",
  "version": "1.0.0-rc.2",
  "private": true,
  "main": "tray-main.js",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "atem-connection": "^3.10.3",
    "bonjour-service": "^1.4.4",
    "escape-string-regexp": "^4.0.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.7",
    "midi": "^1.0.4",
    "nodemcu-tool": "github:wifi-tally/NodeMCU-Tool",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tmp-promise": "^3.0.3",
    "tss-react": "^4.9.21",
    "xml2js": "^0.6.2"
  },
  "scripts": {
    "start:frontend": "vite --host 0.0.0.0",
    "start:backend": "ts-node --project tsconfig.server.json src/server.ts --env=development",
    "build:frontend": "node scripts/write-build-info.js && vite build",
    "build:backend": "tsc --project tsconfig.server.json",
    "build:windows": "npm run build:frontend && npm run build:backend && node scripts/package-windows.js",
    "build:tray": "npm run build:windows && electron-builder --win portable",
    "test": "jest --config jest.standalone.cjs",
    "test:ci": "jest --config jest.standalone.cjs --watch=false --runInBand",
    "cypress:open": "cypress open",
    "cypress:open:manual": "cross-env CYPRESS_INCLUDE_MANUAL=true cypress open",
    "cypress:run": "cypress run",
    "cypress:backend": "ts-node --project tsconfig.server.json src/server.ts --env=development --with-test",
    "lint": "eslint .",
    "preview:frontend": "vite preview",
    "test:frontend:smoke": "node scripts/check-vite-output.cjs && node scripts/check-vite-preview.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tmp": "^0.2.3",
    "@yao-pkg/pkg": "6.23.0",
    "babel-jest": "30.5.2",
    "cross-env": "^7.0.3",
    "cypress": "^16.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-cypress": "7.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-extended": "^0.11.5",
    "lato-font": "^3.0.0",
    "nosleep.js": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-full-screen": "1.1.1",
    "react-router-dom": "^7.18.4",
    "ts-node": "^9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "web-vitals": "^0.2.4"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10"
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm",
    "arm64"
  ],
  "build": {
    "extends": null,
    "appId": "pl.greencrew.gctally",
    "productName": "GC Tally",
    "npmRebuild": false,
    "directories": {
      "output": "dist-tray"
    },
    "files": [
      "tray-main.js",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "dist/gc-tally.exe",
        "to": "gc-tally.exe"
      },
      {
        "from": "dist/frontend",
        "to": "frontend"
      },
      {
        "from": "../art/GreenCrew_Tally_logo.svg",
        "to": "GreenCrew_Tally_logo.svg"
      },
      {
        "from": "tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "dist/esp8266",
        "to": "esp8266"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pkg": {
    "scripts": [
      "node_modules/obs-websocket-js/dist/json.cjs"
    ],
    "assets": [
      "node_modules/@serialport/bindings/build/Release/*.node",
      "node_modules/@serialport/bindings/prebuilds/**/*.node",
      "node_modules/midi/build/Release/*.node"
    ]
  }
}
